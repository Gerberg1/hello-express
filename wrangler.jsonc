
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hello-express",
  "main": "./server.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/messages*"]
  }
}
